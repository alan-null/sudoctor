{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sudoctor generated health expectations",
  "description": "Generated by setup as /etc/sudoctor/health.json. Fields are optional for the collector; setup supplies all of them.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "services": {
      "$ref": "inventory.schema.json#/definitions/services"
    },
    "docker": {
      "$ref": "inventory.schema.json#/definitions/docker"
    },
    "tcp": {
      "$ref": "inventory.schema.json#/definitions/tcp"
    },
    "http": {
      "$ref": "inventory.schema.json#/definitions/http"
    },
    "tmux": {
      "$ref": "inventory.schema.json#/definitions/tmux"
    },
    "disk_warning_percent": {
      "$ref": "inventory.schema.json#/definitions/diskWarningPercent"
    },
    "min_free_mb": {
      "$ref": "inventory.schema.json#/definitions/minFreeMb"
    }
  }
}
