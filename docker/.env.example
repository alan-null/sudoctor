# Inventory directory on the controller (absolute path recommended).
# SUDOCTOR_INVENTORY_DIR=/home/you/.config/sudoctor/inventory

# Notifications: a directory containing notify.json (see docs/notifications.md).
# Without notify.json, no notifications are sent.
# SUDOCTOR_NOTIFY_DIR=/home/you/.config/sudoctor/notify
# Extra notification plugins (*.py). Defaults to the checkout's plugins/ directory.
# SUDOCTOR_PLUGINS_DIR=/home/you/.config/sudoctor/plugins
# Dashboard link included in notifications.
# SUDOCTOR_PUBLIC_URL=https://sudoctor.example.com

# SSH configuration directory mounted into the scheduler.
SUDOCTOR_SSH_DIR=~/.ssh

# Run every 15 minutes. For Sunday at 03:00, use "0 3 * * 0".
SUDOCTOR_CRON=*/15 * * * *
TZ=UTC

SUDOCTOR_HOST_TIMEOUT=180
# For a weekly schedule, increase this value to at least 691200 (8 days).
SUDOCTOR_STALE_SECONDS=3600

# The dashboard listens on the controller's loopback interface by default.
SUDOCTOR_BIND_ADDRESS=127.0.0.1
SUDOCTOR_PORT=8000

# The dashboard checks for a newer release at most once a day. Set false to disable.
# SUDOCTOR_UPDATE_CHECK=true
